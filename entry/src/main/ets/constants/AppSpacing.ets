export class AppSpacing {
  static readonly XXS: number = 4;
  static readonly XS: number = 8;
  static readonly SM: number = 12;
  static readonly MD: number = 16;
  static readonly LG: number = 24;
  static readonly XL: number = 32;
  static readonly XXL: number = 48;
  static readonly XXXL: number = 64;

  // Semantic aliases keep visual intent readable in page layouts.
  static readonly SPACING_XS: number = AppSpacing.XS;
  static readonly SPACING_S: number = AppSpacing.SM;
  static readonly SPACING_M: number = AppSpacing.MD;
  static readonly SPACING_L: number = AppSpacing.LG;
  static readonly SPACING_XL: number = AppSpacing.XL;
}
