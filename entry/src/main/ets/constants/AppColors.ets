/** A central mutable palette. The root rebuild after apply() updates every token consumer. */
export class AppColors {
  static BACKGROUND_PRIMARY: string = '#F5F3EF'; static BACKGROUND_SECONDARY: string = '#EDF0E9'; static SURFACE_PRIMARY: string = '#F6F7F2'; static SURFACE_ELEVATED: string = '#FCFCF8';
